# Copy to .env (git-ignored) or export these in your shell.

# Google Gemini key for the AI chat assistant: https://aistudio.google.com/apikey
# Leave unset to run without AI features.
GEMINI_API_KEY=

# Signs session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
