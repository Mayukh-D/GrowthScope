# Copy to .env (git-ignored) or export these in your shell.

# Google Gemini key for the AI chat assistant: https://aistudio.google.com/apikey
# Leave unset to run without AI features. Free-tier keys are free, but Google
# may use the questions and data summaries sent to improve its products.
GEMINI_API_KEY=
# Optional: any model on the Gemini API. Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=
# Optional: AI questions allowed per visitor session (default 10).
# CHAT_QUESTIONS_PER_SESSION=

# Signs session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Local development only. Never set these on a public deployment.
# FLASK_DEBUG=1                # interactive debugger and auto-reload
# GROWTHSCOPE_DEBUG_ROUTES=1   # enables /debug/session and /debug/cleanup-session
